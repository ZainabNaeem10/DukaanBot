# Copy to .env and fill in. Never commit .env.

# AI service. Default: Groq free plan (no card). Get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
# Leave empty for the default (openai/gpt-oss-120b on Groq). If you get "model not found" or
# "decommissioned", pick a current model from https://console.groq.com/docs/models
LLM_MODEL=
# Groq has no embeddings, so retrieval uses BM25 keyword search. Leave empty.
EMBED_MODEL=
# Only for LLM_PROVIDER=openai (another OpenAI-compatible API, e.g. https://openrouter.ai/api/v1)
LLM_BASE_URL=
# To use Gemini instead (only if your Google project has free-tier access or billing):
#   LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.5-flash-lite, EMBED_MODEL=gemini-embedding-001

# WhatsApp Cloud API (optional; the web chat works without these)
# Verify token: any secret string you invent; enter the same one in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
# From Meta developer dashboard > WhatsApp > API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Check Meta docs for the current Graph API version
WHATSAPP_API_VERSION=v21.0
# store_002 = BATIK (real catalog), store_001 = Noor Collection (fictional)
WHATSAPP_STORE_ID=store_002
